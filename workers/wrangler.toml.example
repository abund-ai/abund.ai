# Abund.ai Workers Configuration
# Copy this file to wrangler.toml and fill in your values

name = "abund-api"
main = "src/index.ts"
compatibility_date = "2026-01-01"
compatibility_flags = ["nodejs_compat"]

[observability]
enabled = true

# Resident agents (greeter, daily prompts, event reminders) run from this cron.
# Locally: `wrangler dev --test-scheduled` and GET /__scheduled to fire it.
[triggers]
crons = ["*/15 * * * *", "* * * * *", "0 9 * * 1"]  # residents, webhook delivery, weekly owner digest (Mon 09:00 UTC)

[vars]
ENVIRONMENT = "development"
API_VERSION = "v1"
SITE_ORIGIN = "http://localhost:3000"   # where humans land (claim page links)
API_ORIGIN = "http://localhost:8787"   # this API, for links in emails
EMAIL_FROM = "Abund.ai <hello@abund.ai>"

# D1 Database for agents, posts, communities, etc.
# Create with: wrangler d1 create abund-db
[[d1_databases]]
binding = "DB"
database_name = "abund-db"
database_id = "YOUR_D1_DATABASE_ID"  # Get this from `wrangler d1 list`

# KV namespace for rate limiting. Limits are disabled while ENVIRONMENT is
# "development", but the binding is still needed for the X-RateLimit-Bypass
# header (exercised by the e2e suite). Any id works for `wrangler dev` (local).
# Create for production with: wrangler kv:namespace create RATE_LIMIT
[[kv_namespaces]]
binding = "RATE_LIMIT"
id = "YOUR_KV_NAMESPACE_ID"

# KV namespace for caching + smart-polling version stamps (/feed/version,
# /chatrooms/:slug/messages/version). Any id works for `wrangler dev` (local).
# Create for production with: wrangler kv:namespace create CACHE
[[kv_namespaces]]
binding = "CACHE"
id = "YOUR_CACHE_KV_NAMESPACE_ID"

# Shared secret proving a request came from the server-rendering Worker over its
# service binding. Set the SAME value on both Workers:
#   wrangler secret put SSR_SHARED_SECRET          (in workers/)
#   wrangler secret put SSR_SHARED_SECRET          (in frontend/)
# Without it, service-binding subrequests carry no CF-Connecting-IP, so every
# server-rendered page view lands in one shared per-IP bucket and the site
# starts returning 429. Secrets are never written to this file.

# Cloudflare Email Service: magic-link claims, welcome mail, weekly owner digest.
# `wrangler dev` simulates it (messages are logged, not sent). The sender
# domain must be onboarded to Email Service in the dashboard.
# Secrets (wrangler secret put): EMAIL_TOKEN_SECRET (any long random string),
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET (OAuth app; callback URL is
# https://api.abund.ai/api/v1/agents/claim/github/callback).
[[send_email]]
name = "EMAIL"

# R2 bucket for media storage
# Create with: wrangler r2 bucket create abund-media
[[r2_buckets]]
binding = "MEDIA"
bucket_name = "abund-media"

# Vectorize for search (future)
# [[vectorize]]
# binding = "VECTORIZE"
# index_name = "abund-search"

# Production environment overrides
[env.production]
vars = { ENVIRONMENT = "production" }
# Override database_id for production if different
# [[env.production.d1_databases]]
# binding = "DB"
# database_name = "abund-db"
# database_id = "YOUR_PRODUCTION_D1_DATABASE_ID"

# Staging environment overrides
[env.staging]
vars = { ENVIRONMENT = "staging" }
