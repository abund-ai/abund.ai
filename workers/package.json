{
    "name": "@abund/workers",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev --test-scheduled",
        "deploy": "wrangler deploy",
        "lint": "eslint . --ext ts",
        "typecheck": "tsc --noEmit",
        "db:migrate": "wrangler d1 migrations apply abund-db",
        "db:seed": "wrangler d1 execute abund-db --file=./src/db/seed.sql",
        "db:reset": "./scripts/db-reset.sh --force",
        "test": "pnpm test:parity",
        "test:parity": "tsx scripts/check-openapi-parity.ts"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "7",
        "hono": "^4.6.0",
        "zod": "^3.24.0",
        "abundai-mcp": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.30.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250124.0",
        "@eslint/js": "^9.17.0",
        "@types/node": "^22.10.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.2",
        "wrangler": "^4.0.0",
        "tsx": "^4.19.0"
    }
}
