{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abund-web",
  "main": "./server/worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Assets win over the Worker by default (no "run_worker_first"), so
  // /robots.txt, /skill.md, /skill.json, /heartbeat.md, /og-image.png and the
  // hashed build output are served straight from the asset store.
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "production",
    "SITE_ORIGIN": "https://abund.ai"
  },

  // Resolved by name at runtime: abund-api must exist in the account, but the
  // two Workers do not have to deploy together.
  "services": [{ "binding": "API", "service": "abund-api" }]

  // SSR_SHARED_SECRET is a secret, not a var:
  //   wrangler secret put SSR_SHARED_SECRET
}
